# ====================================================
# 1. การตั้งค่า Firebase (Cloud Firestore & Auth)
# รับค่าได้ที่: https://console.firebase.google.com -> Project Settings -> General -> Your apps (Web)
# ====================================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ====================================================
# 2. การตั้งค่าเชื่อมต่อ SlipOK API (ระบบตรวจสลิปอัตโนมัติ)
# สมัครใช้งานและรับ API Key ได้ที่: https://slipok.com
# ====================================================
SLIPOK_API_KEY="your_slipok_api_key_here"
SLIPOK_BRANCH_ID="your_branch_id_here"
